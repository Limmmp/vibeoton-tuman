# По умолчанию приложение открывает опубликованную карту: https://limmmp.github.io/vibeoton-tuman/
# Локальный сервер движка на компьютере с Metro (npm run dev в корне репо):
# EXPO_PUBLIC_MAP_SOURCE=local
# Или любой явный адрес движка, доступный с телефона:
# EXPO_PUBLIC_MAP_URL=http://192.168.1.10:5173
