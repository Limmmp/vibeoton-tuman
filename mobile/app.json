{
  "expo": {
    "name": "Туман Владивостока",
    "slug": "tuman-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.tuman.mobile"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геопозиция нужна, чтобы открывать туман там, где вы гуляете."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
