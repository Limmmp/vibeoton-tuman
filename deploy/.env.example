# Домен для HTTPS. Пока у сервера нет своего DNS — адрес sslip.io указывает прямо на IP.
DOMAIN=176-53-248-123.sslip.io

# Демо для защиты: вход по имени и три демо-друга (Петя, Маша, Аня). После хакатона — 0.
DEV_LOGIN=1
SEED_DEMO=1

# Соцсети: провайдер включается, когда задан его ключ. Секреты в репозиторий не коммитить.
# VK ID: id приложения из https://id.vk.com/about/business
VK_CLIENT_ID=
# Telegram Login: токен бота от @BotFather (домен бота — /setdomain)
TELEGRAM_BOT_TOKEN=
# Google: client id (через запятую — веб, Android, iOS)
GOOGLE_CLIENT_IDS=
# Яндекс ID: client id приложения из https://oauth.yandex.ru — токен обязан быть выдан ему
YANDEX_CLIENT_ID=
